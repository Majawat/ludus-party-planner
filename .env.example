# .env.example — commit this. Never commit .env.
# Copy to .env and fill in values before running.
# Generate SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# All other configuration (mail, payments, OAuth, site settings)
# is managed through the Admin Settings UI at /admin/settings.

SECRET_KEY=       # Required. Signs sessions and tokens.
FLASK_APP=app     # Required for flask CLI commands.
DATABASE_URL=sqlite:///data/ludus.db

# Development only — remove in production
# FLASK_DEBUG=1
